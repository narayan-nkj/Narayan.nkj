{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/phoenix", "destination": "https://the-phoenix-protocol.vercel.app", "permanent": false },
    { "source": "/phoenix-protocol", "destination": "https://the-phoenix-protocol.vercel.app", "permanent": false }
  ],
  "rewrites": [
    { "source": "/vanguard", "destination": "/projects/vanguard.html" },
    { "source": "/apex", "destination": "/projects/apex.html" },
    { "source": "/ather", "destination": "/projects/ather.html" },
    { "source": "/reframed", "destination": "/projects/reframed.html" },
    { "source": "/Reframed", "destination": "/projects/reframed.html" },
    { "source": "/singularity", "destination": "/projects/singularity.html" },
    { "source": "/Singularity", "destination": "/projects/singularity.html" },
    { "source": "/nkj2", "destination": "/projects/singularity.html" },
    { "source": "/delta", "destination": "/projects/singularity.html" },
    { "source": "/epsilon", "destination": "/projects/singularity.html" },
    { "source": "/2", "destination": "/projects/vanguard.html" },
    { "source": "/2.html", "destination": "/projects/vanguard.html" },
    { "source": "/3", "destination": "/projects/apex.html" },
    { "source": "/3.html", "destination": "/projects/apex.html" },
    { "source": "/4", "destination": "/projects/ather.html" },
    { "source": "/4.html", "destination": "/projects/ather.html" },
    { "source": "/5", "destination": "/projects/reframed.html" },
    { "source": "/5.html", "destination": "/projects/reframed.html" },
    { "source": "/6", "destination": "/projects/singularity.html" },
    { "source": "/6.html", "destination": "/projects/singularity.html" },
    { "source": "/1", "destination": "/index.html" },
    { "source": "/1.html", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|gif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
